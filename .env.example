# Beep-Boop v2.0 Environment Configuration
# Copy this file to .env and configure your values

# =============================================================================
# APPLICATION SETTINGS
# =============================================================================

# Server Configuration
NODE_ENV=development
PORT=3000
API_VERSION=v1
LOG_LEVEL=info

# CORS and Security
CORS_ORIGIN=http://localhost:3000,http://localhost:3001
JWT_SECRET=your_jwt_secret_here_min_32_chars_long
SESSION_SECRET=your_session_secret_here_min_32_chars

# =============================================================================
# EXTERNAL SERVICE INTEGRATIONS
# =============================================================================

# Digi-Core (Knowledge Butler) - Port 2000
DIGI_CORE_BASE_URL=http://localhost:2000
DIGI_CORE_API_KEY=your_digi_core_api_key_here
DIGI_CORE_ENABLED=true
DIGI_CORE_TIMEOUT=30000
DIGI_CORE_MAX_RETRIES=3

# PCS (Personal Context System) - Port 8000  
PCS_BASE_URL=http://localhost:8000
PCS_API_KEY=your_pcs_api_key_here
PCS_APP_ID=beep-boop-v2
PCS_ENABLED=true
PCS_TIMEOUT=15000
PCS_MAX_RETRIES=3

# Lernmi (Learning System) - Future Integration
LERNMI_BASE_URL=http://localhost:4000
LERNMI_API_KEY=your_lernmi_api_key_here
LERNMI_ENABLED=false

# =============================================================================
# LLM PROVIDERS
# =============================================================================

# Ollama (Primary LLM)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b
OLLAMA_ENABLED=true
OLLAMA_TIMEOUT=60000

# OpenAI (Fallback LLM)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini
OPENAI_ENABLED=true
OPENAI_TIMEOUT=30000

# Anthropic (Alternative Fallback)
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-3-haiku-20240307
ANTHROPIC_ENABLED=false

# GROK (Alternative Fallback)
GROK_API_KEY=your_grok_api_key_here
GROK_MODEL=grok-beta
GROK_ENABLED=false

# =============================================================================
# VOICE SERVICES
# =============================================================================

# Speech-to-Text (OpenAI Whisper)
WHISPER_API_KEY=your_openai_api_key_here
WHISPER_MODEL=whisper-1
WHISPER_ENABLED=true

# Text-to-Speech (ElevenLabs primary, OpenAI fallback)
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
ELEVENLABS_VOICE_ID=your_preferred_voice_id
ELEVENLABS_ENABLED=true

OPENAI_TTS_ENABLED=true
OPENAI_TTS_MODEL=tts-1
OPENAI_TTS_VOICE=alloy

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================

# PostgreSQL (Primary Data Store)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=beep_boop_v2
POSTGRES_USER=beep_boop_user
POSTGRES_PASSWORD=your_postgres_password_here
POSTGRES_SSL=false

# Neo4j (Relationship Graph)
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=your_neo4j_password_here
NEO4J_DATABASE=beep_boop_graph

# Qdrant (Vector Embeddings)
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=your_qdrant_api_key_here
QDRANT_COLLECTION_PROMPTS=beep_boop_prompts
QDRANT_COLLECTION_MEMORIES=beep_boop_memories
QDRANT_COLLECTION_CONTEXTS=beep_boop_contexts

# Redis (Cache & Sessions)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=your_redis_password_here
REDIS_DB=0
REDIS_TTL=3600

# =============================================================================
# FEATURE FLAGS
# =============================================================================

# Core Features
VOICE_ENABLED=true
MEMORY_ENABLED=true
FEEDBACK_ENABLED=true
STREAMING_ENABLED=true

# Advanced Features
PROMPT_EVOLUTION_ENABLED=true
RELATIONSHIP_MAPPING_ENABLED=true
LEARNING_INTEGRATION_ENABLED=false
MULTI_MODAL_ENABLED=false

# =============================================================================
# MONITORING & OBSERVABILITY
# =============================================================================

# Logging
LOG_FORMAT=json
LOG_FILE=logs/beep-boop.log
LOG_MAX_SIZE=10m
LOG_MAX_FILES=5

# Metrics
METRICS_ENABLED=true
PROMETHEUS_PORT=9090

# Tracing
TRACING_ENABLED=true
JAEGER_ENDPOINT=http://localhost:14268/api/traces

# =============================================================================
# DEPLOYMENT CONFIGURATION
# =============================================================================

# Production Settings (chat.tibocin.xyz)
DOMAIN=chat.tibocin.xyz
SSL_ENABLED=true
RATE_LIMIT_REQUESTS=1000
RATE_LIMIT_WINDOW=900000

# CDN and Static Assets
CDN_URL=https://cdn.tibocin.xyz
STATIC_ASSETS_PATH=/app/public

# =============================================================================
# DEVELOPMENT SETTINGS
# =============================================================================

# Hot Reload
WATCH_MODE=true
RELOAD_ON_CHANGE=true

# Debug Features
DEBUG_MODE=false
VERBOSE_LOGGING=false
API_DEBUG=false

# Test Configuration
TEST_DATABASE_URL=postgresql://test_user:test_pass@localhost:5433/beep_boop_test
TEST_TIMEOUT=30000