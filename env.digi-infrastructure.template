# Beep-Boop Environment Configuration - Digi-Infrastructure Setup
# Copy this file to .env and fill in your actual values

# =============================================================================
# OPENAI CONFIGURATION
# =============================================================================
OPENAI_API_KEY=your_openai_api_key_here

# =============================================================================
# DIGI-CORE RAG ENGINE (Primary Knowledge Source)
# =============================================================================
DIGI_CORE_API_URL=http://localhost:8000
DIGI_CORE_API_KEY=your_digi_core_api_key_here
DIGI_CORE_ENABLED=true
DIGI_CORE_MIN_CONFIDENCE=0.3
DIGI_CORE_TIMEOUT=30000
DIGI_CORE_MAX_RETRIES=3

# =============================================================================
# PCS (Personal Context System) - Dynamic Prompt Generation
# =============================================================================
PCS_BASE_URL=http://localhost:8000
PCS_API_KEY=your_pcs_api_key_here
PCS_APP_ID=beep-boop-v2
PCS_ENABLED=true
PCS_TIMEOUT=15000
PCS_MAX_RETRIES=3

# =============================================================================
# DATABASE CONFIGURATION - Digi-Infrastructure Stack
# =============================================================================

# PostgreSQL (Primary Database)
DATABASE_URL=postgresql://username:password@localhost:5432/beep_boop
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DATABASE=beep_boop
POSTGRES_USERNAME=beep_boop_user
POSTGRES_PASSWORD=your_postgres_password_here
POSTGRES_SSL=false

# Neo4j (Graph Database for Relationships)
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=your_neo4j_password_here
NEO4J_DATABASE=beep_boop_graph

# Qdrant (Vector Database for Embeddings)
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=your_qdrant_api_key_here
QDRANT_COLLECTION_PROMPTS=beep_boop_prompts
QDRANT_COLLECTION_MEMORIES=beep_boop_memories
QDRANT_COLLECTION_CONTEXTS=beep_boop_contexts

# Redis (Caching and Session Storage)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=your_redis_password_here
REDIS_DB=0
REDIS_TTL=3600

# =============================================================================
# LLM PROVIDERS (Fallback Options)
# =============================================================================

# Ollama (Local LLM)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b
OLLAMA_ENABLED=true
OLLAMA_TIMEOUT=60000

# OpenAI (Primary/Backup)
OPENAI_MODEL=gpt-4o-mini
OPENAI_ENABLED=true
OPENAI_TIMEOUT=30000

# =============================================================================
# VOICE SERVICES
# =============================================================================

# OpenAI Whisper (Speech-to-Text)
WHISPER_API_KEY=your_openai_api_key_here
WHISPER_MODEL=whisper-1
WHISPER_ENABLED=true

# ElevenLabs (Text-to-Speech)
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
ELEVENLABS_VOICE_ID=your_voice_id_here
ELEVENLABS_ENABLED=false

# OpenAI TTS (Alternative Text-to-Speech)
OPENAI_TTS_ENABLED=true
OPENAI_TTS_MODEL=tts-1
OPENAI_TTS_VOICE=alloy

# =============================================================================
# APPLICATION SETTINGS
# =============================================================================
NODE_ENV=development
PORT=3001
API_VERSION=v1
LOG_LEVEL=info
DEBUG=false

# Security
CORS_ORIGIN=http://localhost:3001
JWT_SECRET=your_jwt_secret_here_minimum_32_characters
SESSION_SECRET=your_session_secret_here_minimum_32_characters

# Rate Limiting
RATE_LIMIT_REQUESTS=1000
RATE_LIMIT_WINDOW=900000

# =============================================================================
# FEATURE FLAGS
# =============================================================================
FEATURE_VOICE=true
FEATURE_MEMORY=true
FEATURE_FEEDBACK=true
FEATURE_STREAMING=true
FEATURE_PROMPT_EVOLUTION=true
FEATURE_RELATIONSHIP_MAPPING=true
FEATURE_LEARNING_INTEGRATION=false
FEATURE_MULTI_MODAL=false

# =============================================================================
# ALTERNATIVE RAG BACKENDS (Fallback)
# =============================================================================
PINECONE_API_KEY=your_pinecone_api_key_here
PINECONE_ENVIRONMENT=your_pinecone_environment
PINECONE_ENABLED=false

# ChromaDB (Local Development)
CHROMA_ENABLED=true
CHROMA_PERSIST_DIRECTORY=./chroma_db

# Hugging Face (Cloud Alternative)
HUGGINGFACE_ENABLED=false
HUGGINGFACE_API_KEY=your_huggingface_api_key_here
